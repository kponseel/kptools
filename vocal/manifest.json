{
  "name": "Vocaux – transcription WhatsApp",
  "short_name": "Vocaux",
  "description": "Transcris tes vocaux WhatsApp, enregistrements, mémos vocaux et vidéos directement sur ton téléphone, sans rien envoyer sur internet.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1412",
  "theme_color": "#0b1412",
  "lang": "fr",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            "application/ogg",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".m4b",
            ".mp3",
            ".aac",
            ".wav",
            ".flac",
            ".webm",
            ".weba",
            ".mka",
            ".amr",
            ".awb",
            ".3gp",
            ".3ga",
            ".3gpp",
            ".wma",
            ".aif",
            ".aiff",
            ".caf",
            ".ac3",
            ".spx",
            ".mp4",
            ".mov",
            ".mkv",
            ".avi",
            ".m4v"
          ]
        }
      ]
    }
  }
}
